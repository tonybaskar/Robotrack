rules_version = '2';

// RoboTrack — single-trainer robotics classroom app.
//
// Collections in use (see src/services/*.js):
//   students    — roster, read/written by the signed-in trainer
//   timetable   — weekly period grid, read/written by the signed-in trainer
//   curriculum  — kits (programs/grade ranges), read/written by the signed-in trainer
//   activities  — activities that belong to a curriculum kit (curriculumId field)
//   toolkits    — physical kit inventory (MEX-001 etc.), read/written by the trainer
//   sessions    — one document per conducted class; owned by the trainer
//                 who started it (trainerId == request.auth.uid)
//
// There is no public-facing data and no anonymous access anywhere in this
// app, so the baseline rule is: signed-in only, everywhere.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Operational data shared by the trainer across devices/sessions.
    // A future admin role (see src/services/auth.js comment) can layer
    // extra checks onto these without changing the shape here.
    match /students/{studentId} {
      allow read, write: if isSignedIn();
    }

    match /timetable/{entryId} {
      allow read, write: if isSignedIn();
    }

    match /curriculum/{kitId} {
      allow read, write: if isSignedIn();
    }

    match /activities/{activityId} {
      allow read, write: if isSignedIn();
    }

match /toolkits/{toolkitId} {
      allow read, write: if isSignedIn();
    }

    // Holidays blank out every class for a date (FEATURE 2) — shared
    // operational data, same model as timetable/curriculum.
    match /holidays/{holidayId} {
      allow read, write: if isSignedIn();
    }

    // Cancellations mark one class period on one date as not conducted
    // (FEATURE 3) — shared operational data, no owner scoping needed.
    match /cancellations/{cancellationId} {
      allow read, write: if isSignedIn();
    }

    // Periodic student assessments (FEATURE 11) — shared operational data;
    // there is only one trainer, so no owner scoping (matches students,
    // labGroups, toolkits above).
    match /assessments/{assessmentId} {
      allow read, write: if isSignedIn();
    }

    // One doc per trainer (docId == auth.uid). Unlike the operational
    // collections above, this must stay owner-scoped — school/contact
    // details for one trainer must never be readable by another.
    match /settings/{trainerId} {
      allow read, write: if isSignedIn() && request.auth.uid == trainerId;
    }

    // Lab groups organize a class's students for practical work. Same
    // shared-operational-data model as students/timetable/curriculum —
    // there is only one trainer using this app, so no owner scoping.
    match /labGroups/{groupId} {
      allow read, write: if isSignedIn();
    }

    // Sessions are scoped to the trainer who started the class. This is the
    // record of what actually happened in a class (attendance, activity,
    // toolkit return, photos, remarks), so writes are restricted to the
    // owner and validated against the fields the app actually sends.
    match /sessions/{sessionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.trainerId == request.auth.uid
        && request.resource.data.status == 'started'
        && request.resource.data.date is string
        && request.resource.data.timetableId is string;

      allow update: if isSignedIn()
        && resource.data.trainerId == request.auth.uid
        // trainerId/timetableId/date must not be swapped out after creation
        && request.resource.data.trainerId == resource.data.trainerId
        && request.resource.data.timetableId == resource.data.timetableId
        && request.resource.data.date == resource.data.date
        && request.resource.data.status in ['started', 'partial', 'completed'];

      allow delete: if isSignedIn() && resource.data.trainerId == request.auth.uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
